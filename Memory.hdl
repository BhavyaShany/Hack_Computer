
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=notA14);
    Not(in=address[13], out=notA13);

    And(a=load, b=notA14, out=ramLoad);

    And(a=load, b=address[14], out=screenTemp);
    And(a=screenTemp, b=notA13, out=screenLoad);

    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);

    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);

    Keyboard(out=keyboardOut);

    Mux16(a=ramOut, b=screenOut, sel=address[14], out=ramScreenOut);

    And(a=address[14], b=address[13], out=keyboardSelect);

    Mux16(a=ramScreenOut, b=keyboardOut, sel=keyboardSelect, out=out);
}
